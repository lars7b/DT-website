##################################################
### ADD ITEM TO CART
##################################################

POST {{baseUrl}}/api/shoppingcart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": 1,
  "productId": 100,
  "quantity": 2
}

##################################################
### UPDATE CART ITEM
##################################################

PUT {{baseUrl}}/api/shoppingcart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": 1,
  "productId": 100,
  "quantity": 5
}

##################################################
### UPDATE WHOLE CART
##################################################

PUT {{baseUrl}}/api/shoppingcart
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": 1,
  "customerId": 1,
  "items": [
    {
      "id": 1,
      "productId": 100,
      "quantity": 2
    },
    {
      "id": 2,
      "productId": 200,
      "quantity": 1
    }
  ]
}

##################################################
### DELETE CART ITEM
##################################################

DELETE {{baseUrl}}/api/shoppingcart/items/1
Authorization: Bearer {{token}}

##################################################
### DELETE WHOLE CART
##################################################

DELETE {{baseUrl}}/api/shoppingcart
Authorization: Bearer {{token}}